# Groq API — https://console.groq.com/keys 에서 발급
# 검색(retrieval)과 평가 스크립트는 키 없이도 동작합니다. 답변 생성에만 필요합니다.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# ── RAG 파라미터 (모두 선택 사항, 비우면 rag/config.py 기본값 사용) ──
# RAG_DATA_DIR=data
# RAG_CHUNK_SIZE=800
# RAG_CHUNK_OVERLAP=150
# RAG_TOP_K=6
# 검색 점수가 이 값 미만이면 근거 없음으로 처리하고 LLM을 호출하지 않습니다.
# RAG_SCORE_THRESHOLD=0.40

# ── LLM HTTP 타임아웃 (초) ──
# RAG_LLM_CONNECT_TIMEOUT=5.0
# RAG_LLM_READ_TIMEOUT=30.0
# RAG_LLM_WRITE_TIMEOUT=10.0
# RAG_LLM_POOL_TIMEOUT=5.0
